{
  "plugins": [
    "stylelint-declaration-strict-value"
  ],
  "rules": {
    "scale-unlimited/declaration-strict-value": [
      [
        "color",
        "background",
        "background-color",
        "background-image",
        "accent-color",
        "text-decoration-color",
        "column-rule-color",
        "-webkit-text-fill-color",
        "/^border(-(top|right|bottom|left))?-color$/",
        "outline-color",
        "caret-color",
        "fill",
        "stroke",
        "box-shadow",
        "font-size",
        "font-family",
        "transition-duration",
        "animation-duration"
      ],
      {
        "ignoreValues": [
          "transparent",
          "currentColor",
          "inherit",
          "initial",
          "unset",
          "none",
          "/^var\\(/",
          "/^color-mix\\(/",
          "Canvas",
          "CanvasText",
          "Highlight",
          "HighlightText",
          "ButtonText",
          "LinkText"
        ],
        "disableFix": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/styles/tokens.css"
      ],
      "rules": {
        "scale-unlimited/declaration-strict-value": null
      }
    },
    {
      "files": [
        "src/styles/fonts.css"
      ],
      "rules": {
        "scale-unlimited/declaration-strict-value": null
      }
    }
  ]
}
